local saveCorner = Instance.new("UICorner")
saveCorner.CornerRadius = UDim.new(0, 6)
saveCorner.Parent = saveBtn

-- Variáveis de estado
local isOn = false
local isDragging = false
local dragStartPos = nil
local dragOffset = nil

-- Função para verificar se clicou em um player
local function getPlayerFromHit(hit)
    if not hit then return nil end
    local char = hit.Parent
    if char and char:FindFirstChild("Humanoid") then
        return Players:GetPlayerFromCharacter(char)
    end
    return nil
end

-- Função principal de clique
local function handleClick(input)
    if not isOn then 
        print("⚠️ Menu está OFF - Clique no botão para ativar")
        return 
    end
    if isDragging then return end
    
    local target = mouse.Target
    if not target and input and input.Position then
        local ray = Ray.new(
            workspace.CurrentCamera.CFrame.Position,
            (workspace.CurrentCamera:ScreenPointToRay(input.Position.X, input.Position.Y).Direction * 1000)
        )
        local hit = workspace:FindPartOnRay(ray, player.Character, false, true)
        if hit then target = hit end
    end
    
    if target then
        local targetPlayer = getPlayerFromHit(target)
        if targetPlayer and targetPlayer ~= player then
            copyText(targetPlayer.Name)
            toggleBtn.BackgroundColor3 = Color3.new(0, 0.8, 0.2)
            task.wait(0.15)
            toggleBtn.BackgroundColor3 = isOn and Color3.new(0.1, 0.3, 0.7) or Color3.new(0.3, 0.3, 0.3)
        end
    end
end

-- Alternar ON/OFF
toggleBtn.MouseButton1Click:Connect(function()
    isOn = not isOn
    toggleBtn.Text = isOn and "ON" or "OFF"
    
    if isOn then
        toggleBtn.BackgroundColor3 = Color3.new(0.1, 0.3, 0.7)
        toggleBtn.BackgroundTransparency = 0.3
        print("🔵 Menu ATIVADO - Clique em players para copiar nomes")
    else
        toggleBtn.BackgroundColor3 = Color3.new(0.3, 0.3, 0.3)
        toggleBtn.BackgroundTransparency = 0.5
        print("⚫ Menu DESATIVADO")
    end
end)

-- Salvar posição
saveBtn.MouseButton1Click:Connect(function()
    local absX = menu.AbsolutePosition.X
    local absY = menu.AbsolutePosition.Y
    salvarPosicao(absX, absY)
    
    -- Feedback visual
    saveBtn.BackgroundColor3 = Color3.new(0, 1, 0)
    saveBtn.Text = "✓"
    task.wait(0.3)
    saveBtn.BackgroundColor3 = Color3.new(0.1, 0.5, 0.1)
    saveBtn.Text = "🔒"
end)

-- Sistema de arraste
menu.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStartPos = input.Position
        dragOffset = Vector2.new(menu.AbsolutePosition.X - input.Position.X, 
                                  menu.AbsolutePosition.Y - input.Position.Y)
    end
end)

menu.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging then
        if input.UserInputType == Enum.UserInputType.MouseMovement or
           input.UserInputType == Enum.UserInputType.Touch then
            local newPos = UDim2.new(0, input.Position.X + dragOffset.X, 
                                     0, input.Position.Y + dragOffset.Y)
            menu.Position = newPos
        end
    end
end)

-- Clique com mouse
mouse.Button1Down:Connect(function()
    task.wait(0.05)
    if not isDragging then
        handleClick(nil)
    end
end)

-- Toque no mobile
UserInputService.TouchStarted:Connect(function(input)
    task.wait(0.05)
    if not isDragging and isOn then
        handleClick(input)
    end
end)

-- Detecção extra para Delta
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        task.wait(0.1)
        if not isDragging and isOn and input.UserInputState == Enum.UserInputState.Began then
            local pos = input.Position
            local ray = Ray.new(
                workspace.CurrentCamera.CFrame.Position,
                (workspace.CurrentCamera:ScreenPointToRay(pos.X, pos.Y).Direction * 1000)
            )
            local hit = workspace:FindPartOnRay(ray, player.Character, false, true)
            if hit then
                local targetPlayer = getPlayerFromHit(hit)
                if targetPlayer and targetPlayer ~= player then
                    copyText(targetPlayer.Name)
                    toggleBtn.BackgroundColor3 = Color3.new(0, 0.8, 0.2)
                    task.wait(0.15)
                    toggleBtn.BackgroundColor3 = isOn and Color3.new(0.1, 0.3, 0.7) or Color3.new(0.3, 0.3, 0.3)
                end
            end
        end
    end
end)

print("✅ Mini Menu Delta com salvamento carregado!")
print("🔘 Menu inicia OFF - Clique no botão para ativar (ON)")
print("🔒 Clique em 🔒 para salvar a posição atual")
