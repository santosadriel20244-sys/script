--[[
    Mini Menu Arrastável - VERSÃO DELTA COM SALVAMENTO
    - Botão ON/OFF Azul (inicia OFF)
    - Botão Salvar Posição (🔒)
    - Quando ON, tocar em um player copia o nome
--]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Sistema de salvamento (usa o arquivo de dados do executor)
local saveKey = "MiniMenu_Posicao"
local savedData = getrenv and getrenv()._G or _G

local function salvarPosicao(x, y)
    -- Tenta salvar em diferentes lugares
    local dados = {
        x = x,
        y = y
    }
    
    -- Método 1: Armazenar na memória do executor
    pcall(function()
        savedData[saveKey] = dados
    end)
    
    -- Método 2: Usar writefile se disponível (para salvar em arquivo)
    pcall(function()
        if writefile then
            writefile("MiniMenu_Posicao.txt", game:GetService("HttpService"):JSONEncode(dados))
        end
    end)
    
    print("💾 Posição salva: X=" .. x .. ", Y=" .. y)
end

local function carregarPosicao()
    -- Tenta carregar da memória
    local dados = pcall(function()
        return savedData[saveKey]
    end) and savedData[saveKey]
    
    -- Se não tiver na memória, tenta carregar do arquivo
    if not dados then
        pcall(function()
            if isfile and isfile("MiniMenu_Posicao.txt") then
                local conteudo = readfile("MiniMenu_Posicao.txt")
                dados = game:GetService("HttpService"):JSONDecode(conteudo)
            end
        end)
    end
    
    return dados
end

-- Função de cópia compatível com Delta
local function copyText(text)
    local success, err = pcall(function()
        if toclipboard then
            toclipboard(text)
        elseif setclipboard then
            setclipboard(text)
        elseif setrbxclipboard then
            setrbxclipboard(text)
        else
            local clipboard = syn and syn.clipboard or (clipboard and clipboard.set)
            if clipboard and clipboard.set then
                clipboard.set(text)
            elseif clipboard and clipboard.write then
                clipboard.write(text)
            else
                warn("Nenhuma função de clipboard encontrada")
                return false
            end
        end
        return true
    end)
    
    if success then
        print("✅ Nome copiado: " .. text)
        return true
    else
        warn("❌ Falha ao copiar: " .. tostring(err))
        return false
    end
end

-- Criar a GUI
