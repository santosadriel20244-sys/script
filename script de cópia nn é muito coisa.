--[[
    Mini Menu Arrastável - VERSÃO DELTA
    - Botão ON/OFF Azul (inicia OFF)
    - Quando ON, tocar em um player copia o nome (compatível com Delta)
--]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Função de cópia compatível com Delta
local function copyText(text)
    local success, err = pcall(function()
        -- Delta usa toclipboard() ou setclipboard()
        if toclipboard then
            toclipboard(text)
        elseif setclipboard then
            setclipboard(text)
        elseif setrbxclipboard then
            setrbxclipboard(text)
        else
            -- Fallback: tenta via sintaxe do executor
            local clipboard = syn and syn.clipboard or (clipboard and clipboard.set)
            if clipboard and clipboard.set then
                clipboard.set(text)
            elseif clipboard and clipboard.write then
                clipboard.write(text)
            else
                warn("Nenhuma função de clipboard encontrada")
                return false
            end
        end
        return true
    end)
    
    if success then
        print("✅ Nome copiado: " .. text)
        return true
    else
        warn("❌ Falha ao copiar: " .. tostring(err))
        return false
    end
end

-- Criar a GUI
